        xmlns:local="clr-namespace:PwerCalc"
        mc:Ignorable="d"
        Title="PowerCalc by PanLectric" Height="800" Width="1200" Background="#FFA4E8C4" BorderBrush="Black">
    <Grid x:Name="Grid" Margin="5,10,5,5" Background="#FFA4E8C4" Width="200" Height="300">
        
        <Image HorizontalAlignment="Left" Height="207" Margin="32,63,0,0" VerticalAlignment="Top" Width="452" Source="/Overview_Pelton.bmp"/>
        <Image HorizontalAlignment="Left" Height="192" Margin="151,219,0,0" VerticalAlignment="Top" Width="214" Source="/Francis.bmp"/>
        <Label x:Name="Parameter_Label" Content="Bekannte Werte eingeben:" HorizontalAlignment="Left" Margin="52,411,0,0" VerticalAlignment="Top" Width="284" FontWeight="Bold" Height="26"/>
        <DockPanel Width="200" Height="303">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File">
                </MenuItem>
            </Menu>

        </DockPanel>
    </Grid>

</Window>
