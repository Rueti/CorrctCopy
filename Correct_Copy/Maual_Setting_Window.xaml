<Window x:Class="Correct_Copy.Maual_Setting_Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Robocopy-Optionen" Width="1060" Height="680" MinWidth="700" MinHeight="450" WindowStartupLocation="CenterOwner" Background="#F3F5F8">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="Robocopy-Optionen" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Checkbox aktivieren; bei Bedarf den Wert daneben anpassen. Details stehen im Tooltip." Margin="0,6,0,0" TextWrapping="Wrap"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Nach Parameter, Beschreibung oder Gruppe suchen" Padding="8" Margin="0,12,0,6"/><TextBlock x:Name="CountText" Foreground="#536174"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="Spiegeln, Bereinigen und Verschieben können Dateien löschen. Prüfen Sie zuerst einen Testlauf." Foreground="#AD4318" TextWrapping="Wrap"/><Button Content="Fertig" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Padding="24,8" Margin="0,10,0,0"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="OptionsList">
   <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
   <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="{Binding Hint}"><TextBlock TextWrapping="Wrap"><Run Text="/"/><Run Text="{Binding Switch, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}"/></TextBlock></CheckBox>
    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}" IsEnabled="{Binding Enabled}" Padding="6" Margin="8,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasValue}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
   </Grid></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></ScrollViewer>
 </DockPanel>
</Window>
